# Copy to .env and fill in. Never commit .env.

# Panta API key (pk_test_... or pk_live_...): register + create a key at https://docs.panta.market/quickstart
PANTA_API_KEY=
# Attribution id sent as X-User-Id so Panta credits volume routed through Fairline
PANTA_USER_ID=fairline

# Solami API key: https://solami.dev (RPC + WebSocket used for the live tape and for relaying signed transactions)
SOLAMI_API_KEY=
# Optional overrides (default: Solami when SOLAMI_API_KEY is set, else public mainnet RPC)
# SOLANA_RPC_URL=
# SOLANA_WS_URL=

# x402 agent payments (optional). Empty PAY_TO = agent routes stay free (demo mode).
# PAY_TO=
# X402_NETWORK=eip155:8453
# PUBLIC_URL=https://your-deployment.example

# Fixture board
# FIXTURE_DAYS=4
# FIXTURE_SPORTS=football,basketball,tennis,ice-hockey
